# Paste your Atlas connection string (Atlas > Connect > Drivers). URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Everything lives in ONE collection called "swipe" inside this database. Drop that collection to delete it all.
MONGODB_DB=test
MONGODB_COLLECTION=swipe

# Interswitch LIVE (hackathon). Merchant code is shared; pick YOUR team's Pay Item ID from the table below.
ISW_MODE=LIVE
ISW_MERCHANT_CODE=MX153376
# Team 1=5558761  2=9616745  3=7139718  4=6948139  5=2616065
# Team 6=8464606  7=5826784  8=9915308  9=7398012  10=9381029
ISW_PAY_ITEM_ID=5558761

# Sandbox instead? Comment the four lines above and use: ISW_MODE=TEST (defaults to public sandbox credentials MX6072 / 9405967)
# SKIP_VERIFY=1
# DEMO_PAYMENTS=1
